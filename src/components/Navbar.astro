---
import MobileMenu from "./MobileMenu.astro";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
  { to: "/", label: "Works" },
  { to: "/about", label: "About" },
  { to: "/contact", label: "Contact" },
];
---

<header class="siteHeader">
  <MobileMenu pathname={pathname} />
  <div class="navbarBar">
    <div class="navbarInner">
      <a class="siteName" href="/">
        Sam
        <br />
        Ticknor
      </a>
      <div class="navbarLinks mobileGap">
        {
          links.map((link) => (
            <a
              class:list={[
                "navLink",
                pathname === link.to ? "navLink--active" : "clickable",
              ]}
              href={link.to}
            >
              {link.label}
            </a>
          ))
        }
      </div>
      <label for="mobileMenuToggle" class="mobileMenuButton clickable">
        <span class="mobileMenuButtonLabel-open">Menu +</span>
        <span class="mobileMenuButtonLabel-close">Menu −</span>
      </label>
    </div>
  </div>
</header>
