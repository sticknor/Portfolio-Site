---
import Layout from "../layouts/Layout.astro";
import about from "../data/about.json";

const bioImage = about.bioImage;
---

<Layout title={`About — ${about.siteTitle}`} ogImage={bioImage?.src}>
  <div class="pageAbout pageShell" style={{ minHeight: "100vh" }}>
    <div class="pageAbout-inner pageInner pageStack mobileStack mobileGap">
      <div class="pageAbout-portrait">
        {
          bioImage && (
            <img
              alt="Studio portrait of Sam Ticknor"
              class="pageAbout-portraitImg"
              src={bioImage.src}
              srcset={bioImage.srcSet}
              sizes="(max-width: 860px) 100vw, 350px"
              width={bioImage.width}
              height={bioImage.height}
              loading="lazy"
              decoding="async"
            />
          )
        }
      </div>
      <div class="pageStack mobileGap">
        {
          about.bio && (
            <div
              class="pageAbout-bio type-prose"
              style={{
                maxWidth: "900px",
                whiteSpace: "pre-wrap",
                width: "100%",
              }}
            >
              {about.bio}
            </div>
          )
        }
        {
          about.showCV && (
            <a
              href="/cv"
              class="clickable navLink"
              style={{ textDecoration: "underline" }}
            >
              CV
            </a>
          )
        }
      </div>
    </div>
  </div>
</Layout>
