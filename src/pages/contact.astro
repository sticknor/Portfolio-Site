---
import Layout from "../layouts/Layout.astro";
import about from "../data/about.json";
import { SUBSTACK } from "../lib/substack.js";
---

<Layout title={`Contact — ${about.siteTitle}`}>
  <div class="pageShell" style={{ minHeight: "100vh" }}>
    <div class="pageInner pageStack pageStack--loose mobileStack mobileGap">
      <div>
        To receive the occasional studio update, such as exhibition
        announcements and studio sales,
        <br />
        <a
          target="_blank"
          rel="noreferrer"
          href={SUBSTACK.announcementsSignup}
          style={{ fontWeight: 600 }}
          class="clickable"
        >
          sign up for my mailing list
        </a>
      </div>

      <div>
        I'm on Instagram,
        <br />
        <a
          target="_blank"
          rel="noreferrer"
          href="https://www.instagram.com/sammytthebrave/"
          style={{ fontWeight: 600 }}
          class="clickable"
        >
          @sammytthebrave
        </a>
      </div>

      <div>
        Email me with inquiries, opportunities, questions, greetings,
        <br />
        <a
          target="_blank"
          rel="noreferrer"
          href="mailto:srticknor@gmail.com"
          style={{ fontWeight: 600 }}
          class="clickable"
        >
          srticknor@gmail.com
        </a>
      </div>
    </div>
  </div>
</Layout>
