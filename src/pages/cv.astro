---
import Layout from "../layouts/Layout.astro";
import about from "../data/about.json";
import cv from "../data/cv.json";
---

<Layout title={`CV — ${about.siteTitle}`}>
  <div class="pageShell">
    <div class="pageInner mobilePadding">
      {
        cv.map(({ category, records }) => (
          <div class="cvCategory">
            <div class="homeMenuHeading">{category}</div>
            {records.map((record) => (
              <div class="cvEntry">
                <div>{record.line1}</div>
                {record.line2 && <div class="cvEntryDetail">{record.line2}</div>}
                {record.line3 && <div class="cvEntryDetail">{record.line3}</div>}
                {record.line4 && <div class="cvEntryDetail">{record.line4}</div>}
                {record.link.url && (
                  <a
                    class="cvEntryDetail"
                    target="_blank"
                    rel="noreferrer"
                    href={record.link.url}
                  >
                    {record.link.title || record.link.url}
                  </a>
                )}
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</Layout>
